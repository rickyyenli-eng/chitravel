# 複製成 .env 後填入。.env 已被 .gitignore 擋掉，不會進版控。

# 必填：Anthropic API 金鑰，到 console.anthropic.com 申請
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# 若你的金鑰是「綁定身分」的（personal 或 service account key），這欄必填。
# 到 console.anthropic.com → Settings → Workspaces，複製 ID 欄位（wrkspc_ 開頭）。
# 建立時就綁定單一 workspace 的金鑰可以留空。
ANTHROPIC_WORKSPACE_ID=

# 搜尋查證用（選填）。沒填就跳過查證，行程照常出得來。
# 到 tavily.com 申請，免費額度每月 1000 次。
TAVILY_API_KEY=

# 行程編排用的模型（會推理、算動線，別省這一步）
PLANNER_MODEL=claude-sonnet-4-5

# 之後要做資料萃取時用的便宜模型（目前尚未使用）
EXTRACT_MODEL=claude-haiku-4-5

# 伺服器埠號
PORT=8787

# 每個 IP 每分鐘最多幾次請求
RATE_LIMIT_PER_MIN=6

# 相同條件的結果快取幾秒（0 = 不快取）
CACHE_TTL_SECONDS=600
