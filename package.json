{
  "name": "shunlu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "順路走 — 行程規劃後端骨架",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "models": "tsx scripts/list-models.ts",
    "fetch:metro": "tsx scripts/fetch-metro.ts",
    "fetch:rail": "tsx scripts/fetch-rail.ts",
    "test": "tsx tests/metro.test.ts && tsx tests/count.test.ts && tsx tests/fix.test.ts && tsx tests/leg.test.ts && tsx tests/anchor.test.ts && tsx tests/train-time.test.ts && tsx tests/hours.test.ts && tsx tests/rail.test.ts",
    "test:live": "tsx tests/rail-live.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
